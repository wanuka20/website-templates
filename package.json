{
  "name": "website-templates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "npm run cache:clear && next dev",
    "cache:clear": "node scripts/clear-next-cache.mjs",
    "build": "next build",
    "start": "next start",
    "start:test": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "node scripts/run-playwright.mjs tests/e2e --grep-invert @live",
    "test:accessibility": "node scripts/run-playwright.mjs tests/e2e/accessibility.spec.ts --project=chromium",
    "test:migration:rehearsal": "node scripts/run-gym-migration-rehearsal.mjs",
    "db:rehearsal:apply": "node --env-file-if-exists=.env.local scripts/apply-gym-rehearsal-schema.mjs",
    "db:rehearsal:seed": "node --env-file-if-exists=.env.local scripts/seed-gym-migration-rehearsal.mjs",
    "db:foundation:recovery:capture": "node --env-file-if-exists=.env.local scripts/verify-gym-foundation-recovery.mjs capture",
    "db:foundation:recovery:verify": "node --env-file-if-exists=.env.local scripts/verify-gym-foundation-recovery.mjs verify",
    "test:leads": "node scripts/run-live-lead-tests.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:lighthouse:summary": "node scripts/summarize-lighthouse.mjs",
    "test:probes": "node scripts/run-production-probes.mjs",
    "test:production": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.7",
    "lucide-react": "^0.460.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "lighthouse": "^13.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
