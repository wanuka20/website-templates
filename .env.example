# Site URL (used for SEO canonical URLs and OG tags)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Google Sheets CMS response cache duration, in seconds. Default: 300 (5 minutes).
# Use a positive whole number. Change this in .env.local for local development
# and in your hosting provider's environment variables for production.
GOOGLE_SHEETS_REVALIDATE_SECONDS=300

# Maximum time to wait for Google Apps Script before keeping cached content.
# Use a positive whole number in milliseconds. Default: 10000 (10 seconds).
GOOGLE_SHEETS_REQUEST_TIMEOUT_MS=10000

# Maximum time a visitor waits for a contact-form response. Default: 15000 (15 seconds).
# This is bundled into the browser, so restart local development or redeploy after changing it.
NEXT_PUBLIC_LEAD_SUBMISSION_TIMEOUT_MS=15000

# Shared server-side Google Apps Script URL for content and the /api/leads proxy.
# Prefer this over NEXT_PUBLIC_* when every template uses one deployment.
# GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SHARED_DEPLOYMENT_ID/exec

# Legacy public fallback retained for existing deployments.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwFCErTZkR4zA0EEprvY3QbNFKfLB6pZ-3xckaYyIyvHY9JLtsXMbBCXeKViOLLkHC8/exec

# Per-template Google Apps Script web app URLs.
# Use these when each template has its own Apps Script deployment.
# The non-public values are used by server-rendered content and lead submission.
# NEXT_PUBLIC_* values are compatibility fallbacks and are no longer required
# by contact forms in the browser.
# NEXT_PUBLIC_GYM_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_GYM_DEPLOYMENT_ID/exec
# GYM_GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_GYM_DEPLOYMENT_ID/exec
# NEXT_PUBLIC_RESTAURANT_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_RESTAURANT_DEPLOYMENT_ID/exec
# RESTAURANT_GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_RESTAURANT_DEPLOYMENT_ID/exec
# NEXT_PUBLIC_SALON_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SALON_DEPLOYMENT_ID/exec
# SALON_GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SALON_DEPLOYMENT_ID/exec
# NEXT_PUBLIC_REALESTATE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_REALESTATE_DEPLOYMENT_ID/exec
# REALESTATE_GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_REALESTATE_DEPLOYMENT_ID/exec
# NEXT_PUBLIC_TUITION_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_TUITION_DEPLOYMENT_ID/exec
# TUITION_GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_TUITION_DEPLOYMENT_ID/exec

# Optional: Email integration (add your email service credentials here)
# Example using Resend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_EMAIL=hello@yourdomain.com

# Example using SendGrid:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# Non-production Gym database rehearsal only. Keep the real value in ignored
# .env.local, never configure it in Vercel, and never point it at production.
# GYM_REHEARSAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST/REHEARSAL_DB?sslmode=verify-full
